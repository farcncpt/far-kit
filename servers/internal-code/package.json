{
  "name": "internal-code-mcp",
  "version": "0.1.0",
  "description": "Internal Code Validator MCP Server - Static analysis for code structure and dependencies",
  "main": "dist/index-internal-code.js",
  "type": "module",
  "bin": {
    "internal-code": "dist/cli.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "cli": "node dist/cli.js",
    "start": "node dist/index-internal-code.js",
    "dev": "tsc --watch",
    "test": "npm run build && node dist/test_suite.js"
  },
  "keywords": [
    "mcp",
    "static-analysis",
    "code-validation"
  ],
  "author": "",
