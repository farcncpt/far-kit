  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "glob": "^10.3.10",
    "madge": "^7.0.0",
    "ts-morph": "^21.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/madge": "^5.0.3",
    "@types/node": "^22.9.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.6.3"
  }
}